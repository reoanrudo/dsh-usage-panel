{
  "name": "@dsh-community/dsh-usage-panel",
  "version": "1.2.0",
  "description": "Usage panel for DeepSeek Harness: GLM, opencode go, Codex, Claude, DeepSeek & Command Code subscriptions in one popup, with quota-reset buttons",
  "license": "MIT",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
